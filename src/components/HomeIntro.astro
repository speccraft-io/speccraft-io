---
// The home page intro, shown as a card in the right sidebar (pages with `intro: true`).
// Neutral structure; pink and green only where they mean something (see /design).
const steps = [
	['Write it down', 'states, steps and rules'],
	['Let a tool check it', 'every order, every input'],
];
// One tile per example on the home page, linking to its section. The pink dot marks a problem.
const examples = [
	['Quint', 'late reply', '#can-a-slow-response-overwrite-newer-search-results'],
	['TLA+', 'timer race', '#what-if-the-approval-and-the-24h-timeout-fire-at-the-same-time'],
	['Lean', 'negative price', '#can-this-discount-make-the-price-negative'],
	['Dafny', 'missed id', '#does-this-binary-search-find-every-id'],
];
---

<div class="home-intro">
	<p class="eyebrow">Formal methods for TypeScript</p>
	<p class="lead">Part of your system is too big to hold in your head?</p>
	<ol>
		{
			steps.map(([title, detail]) => (
				<li>
					<strong>{title}</strong>
					<span>{detail}</span>
				</li>
			))
		}
		<li>
			<strong>Get an answer</strong>
			<span class="answers">
				<span class="tag fine">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 5" /></svg>a verdict
				</span>
				or
				<span class="tag problem">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v6.5M8 12.5v.5" /></svg>the exact trace
				</span>
			</span>
		</li>
	</ol>
	<div class="examples">
		<p class="examples-title">Worked examples</p>
		<ul>
			{
				examples.map(([tool, problem, href]) => (
					<li>
						<a href={href}>
							<b>{tool}</b>
							<span>{problem}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.home-intro {
		/* The fixed right sidebar is wider than its visible column, so size the card to that column: Starlight makes it
		   the sidebar width plus half the space left beside the content. */
		box-sizing: border-box;
		max-width: min(
			18.5rem,
			calc(
				var(--sl-sidebar-width) + (100vw - 2 * var(--sl-sidebar-width) - var(--sl-content-width)) / 2 - 2 *
					var(--sl-sidebar-pad-x) - 0.5rem
			)
		);
		margin: 1rem var(--sl-sidebar-pad-x);
		padding: 1.25rem;
		border: 1px solid var(--sc-border);
		border-radius: 1rem;
		background: var(--sc-surface);
		color: var(--sc-text);
	}
	.home-intro p {
		margin: 0;
	}
	.eyebrow {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sc-muted);
	}
	.lead {
		margin-top: 0.5rem !important;
		font-family: var(--sc-font-heading);
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.25;
	}

	/* The three steps, joined by a line into a small timeline. */
	ol {
		list-style: none;
		counter-reset: step;
		margin: 1.25rem 0 0;
		padding: 0;
	}
	ol li {
		counter-increment: step;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.1rem 0 1rem 2.1rem;
		line-height: 1.3;
	}
	ol li:last-child {
		padding-bottom: 0;
	}
	ol li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: 0;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		background: var(--sc-text);
		color: var(--sc-bg);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.5rem;
		text-align: center;
	}
	ol li:not(:last-child)::after {
		content: '';
		position: absolute;
		left: calc(0.75rem - 1px);
		top: 1.85rem;
		bottom: 0.3rem;
		width: 2px;
		background: var(--sc-border);
	}
	ol strong {
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	ol li > span {
		font-size: var(--sl-text-xs);
		color: var(--sc-muted);
	}
	.answers {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.2rem;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
	}
	.tag svg {
		width: 0.8rem;
		height: 0.8rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tag.fine {
		background: var(--sc-green-tint);
		color: var(--sc-green-text);
	}
	.tag.problem {
		background: var(--sc-pink-tint);
		color: var(--sc-pink-text);
	}

	/* Links to the examples below. */
	.examples {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--sc-border);
	}
	.examples-title {
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.examples ul {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		list-style: none;
		margin: 0.65rem 0 0;
		padding: 0;
	}
	.examples a {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.5rem 0.6rem;
		border: 1px solid var(--sc-border);
		border-radius: 0.75rem;
		background: var(--sc-bg);
		color: var(--sc-text);
		text-decoration: none;
		line-height: 1.25;
		transition: border-color 0.15s;
	}
	.examples a:hover,
	.examples a:focus-visible {
		border-color: var(--sc-text);
	}
	.examples b {
		font-size: var(--sl-text-sm);
	}
	.examples a span {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		white-space: nowrap;
		color: var(--sc-muted);
	}
	.examples a span::before {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--sc-pink);
		flex: none;
	}

	@media (max-width: 71.99rem) {
		.home-intro {
			max-width: none;
			margin: 0.75rem var(--sl-content-pad-x) 0;
		}
		.examples ul {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
