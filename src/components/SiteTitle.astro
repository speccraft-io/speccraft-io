---
// The site title: the logo, then "SpecCraft" in the plain text color. The logo carries the color (see /design).
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<img alt={config.logo.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />
		)
	}
	<span translate="no">SpecCraft</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: var(--sl-nav-gap);
		font-size: var(--sl-text-h4);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--sc-text);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	img {
		height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
		width: auto;
		max-width: 100%;
		object-fit: contain;
		object-position: 0 50%;
	}
</style>
