---
// The site title: "Spec" in white (the logo's near-black on the light theme), "Craft" in the green of the C.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<img alt={config.logo.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />
		)
	}
	<span translate="no"><span class="spec">Spec</span><span class="craft">Craft</span></span>
</a>

<style>
	.site-title {
		/* Logo colors on dark backgrounds; darker shades of the same hues keep contrast on light ones. */
		--spec: #ffffff;
		--craft: #64d673;
		align-items: center;
		gap: var(--sl-nav-gap);
		font-size: var(--sl-text-h4);
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	:global([data-theme='light']) .site-title {
		--spec: #222222;
		--craft: #1e8a3c;
	}
	.spec {
		color: var(--spec);
	}
	.craft {
		color: var(--craft);
	}
	img {
		height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
		width: auto;
		max-width: 100%;
		object-fit: contain;
		object-position: 0 50%;
	}
</style>
