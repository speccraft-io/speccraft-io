---
// Override of Starlight's SocialIcons: the header shows contact links as text, not icons.
---

<a class="contact-pill" href="mailto:alex@zalizniak.com">
	<span class="name">Oleksandr Zalizniak </span>&lt;alex@zalizniak.com&gt;
</a>
<a class="contact-pill" href="https://www.linkedin.com/in/ozalizniak/" target="_blank" rel="noopener noreferrer">
	LinkedIn
</a>

<style>
	@layer starlight.core {
		/* Neutral links: pink is kept for links in text and for problems (see /design). */
		.contact-pill {
			color: var(--sc-muted);
			border: 1px solid var(--sc-border);
			border-radius: 999px;
			padding: 0.25em 0.75em;
			font-size: var(--sl-text-xs);
			line-height: 1.6;
			white-space: nowrap;
			text-decoration: none;
		}
		.contact-pill:hover {
			color: var(--sc-text);
			border-color: var(--sc-muted);
		}
		/* The name does not fit next to the sidebar toggle on a phone. */
		@media (max-width: 50rem) {
			.name {
				display: none;
			}
		}
	}
</style>
