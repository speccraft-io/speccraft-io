---
// Override of Starlight's SocialIcons: same markup, but every header link opens in a new tab.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a {href} target="_blank" rel="me noopener noreferrer" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
			{/* zalizniak.com: a personal link with its own favicon, not a built-in icon. */}
			<a href="https://zalizniak.com/" target="_blank" rel="me noopener noreferrer" class="sl-flex zalizniak-link">
				<span class="sr-only">zalizniak.com</span>
				<img src="/zalizniak-icon.png" alt="" width="16" height="16" decoding="async" />
			</a>
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
		/* Match the built-in social SVG icons' rendered size. */
		.zalizniak-link img {
			display: block;
			width: 1em;
			height: 1em;
			border-radius: 3px;
		}
	}
</style>
