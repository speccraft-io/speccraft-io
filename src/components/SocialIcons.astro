---
// Override of Starlight's SocialIcons: the header shows one link to the editor as text, not an icon.
// Contact links are in the "Let's Connect" section at the bottom of the root page and on /contact.
---

<a class="contact-pill" href="https://app.speccraft.io/" target="_blank" rel="noopener noreferrer">
	app.speccraft.io
</a>

<style>
	@layer starlight.core {
		/* Neutral link: pink is kept for links in text and for problems (see /design). */
		.contact-pill {
			color: var(--sc-muted);
			border: 1px solid var(--sc-border);
			border-radius: 999px;
			padding: 0.25em 0.75em;
			font-size: var(--sl-text-xs);
			line-height: 1.6;
			white-space: nowrap;
			text-decoration: none;
		}
		.contact-pill:hover {
			color: var(--sc-text);
			border-color: var(--sc-muted);
		}
	}
</style>
