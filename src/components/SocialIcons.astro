---
// Override of Starlight's SocialIcons: the header shows a pre-release badge as text, not an icon.
// The link to the editor returns here once it is released.
// Contact links are in the "Let's Connect" section at the bottom of the root page and on /contact.
---

<span class="contact-pill">Pre-release · coming soon</span>

<style>
	@layer starlight.core {
		/* Neutral link: pink is kept for links in text and for problems (see /design). */
		.contact-pill {
			color: var(--sc-muted);
			border: 1px solid var(--sc-border);
			border-radius: 999px;
			padding: 0.25em 0.75em;
			font-size: var(--sl-text-xs);
			line-height: 1.6;
			white-space: nowrap;
			text-decoration: none;
		}
	}
</style>
