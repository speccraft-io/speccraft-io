---
// Replaces the right-hand "On this page" column with an adoption box on pages that declare `adoption`
// in their frontmatter. Other pages keep Starlight's table of contents off (see astro.config.mjs).
import { similarTools } from '../tool-kinds';

const { adoption, requires } = Astro.locals.starlightRoute.entry.data;
const similar = adoption ? similarTools(Astro.url.pathname) : undefined;
const toggleLabel = adoption ? 'Adoption, dependencies and similar tools' : 'Dependencies';

const shield = (path: string, label: string) =>
	`https://img.shields.io/${path}?style=flat&label=${encodeURIComponent(label)}`;

const days = adoption ? Math.floor((Date.now() - adoption.created.getTime()) / (24 * 60 * 60 * 1000)) : 0;
const plural = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'}`;
function ageOf(d: number): string {
	if (d < 31) return plural(d, 'day');
	if (d < 365) return plural(Math.round(d / 30.44), 'month');
	return `${(d / 365.25).toFixed(1)} years`;
}
const age = ageOf(days);
const since = adoption?.created.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

{
	(adoption || requires) && (
		<button type="button" class="tool-info-toggle" aria-expanded="false" aria-controls="tool-info">
			{toggleLabel}
		</button>
	)
}

<div id="tool-info" class="tool-info">
{
	adoption && (
		<div class="adoption">
			<h2>Adoption</h2>
			<a href={`https://github.com/${adoption.github}`} target="_blank" rel="noopener noreferrer">
				<img src={shield(`github/stars/${adoption.github}`, 'GitHub stars')} alt="GitHub stars" />
			</a>
			{adoption.npm && (
				<a href={`https://www.npmjs.com/package/${adoption.npm}`} target="_blank" rel="noopener noreferrer">
					<img src={shield(`npm/dm/${adoption.npm}`, 'npm downloads')} alt="npm downloads per month" />
				</a>
			)}
			<p>
				Age: {age}, since {since}
			</p>
			<p class="last-commit" data-repo={adoption.github} hidden>
				Last commit: <a href={`https://github.com/${adoption.github}/commits`} target="_blank" rel="noopener noreferrer"></a>
			</p>
		</div>
	)
}

{
	requires && (
		<div class="adoption similar">
			<h2>Dependencies</h2>
			<ul>
				{requires.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</div>
	)
}

{
	similar && (
		<div class="adoption similar">
			<h2>Similar tools</h2>
			<p>{similar.kind}</p>
			<ul>
				{similar.tools.map((tool) => (
					<li>
						<a href={tool.link}>{tool.label}</a>
					</li>
				))}
			</ul>
		</div>
	)
}

</div>

<script>
	// The last commit date comes from the GitHub API in the browser, so it is current on every visit.
	const units: [Intl.RelativeTimeFormatUnit, number][] = [
		['year', 365.25 * 24 * 3600],
		['month', 30.44 * 24 * 3600],
		['week', 7 * 24 * 3600],
		['day', 24 * 3600],
		['hour', 3600],
		['minute', 60],
	];

	function relative(date: Date): string {
		const seconds = (date.getTime() - Date.now()) / 1000;
		const format = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
		for (const [unit, size] of units) {
			if (Math.abs(seconds) >= size) return format.format(Math.round(seconds / size), unit);
		}
		return 'just now';
	}

	async function showLastCommit(el: HTMLElement): Promise<void> {
		try {
			const response = await fetch(`https://api.github.com/repos/${el.dataset['repo']}/commits?per_page=1`);
			if (!response.ok) return;
			const [latest] = (await response.json()) as { commit: { committer: { date: string } } }[];
			if (latest === undefined) return;
			const date = new Date(latest.commit.committer.date);
			const link = el.querySelector('a');
			if (link === null) return;
			link.textContent = relative(date);
			link.title = date.toISOString().slice(0, 10);
			el.hidden = false;
		} catch {
			// Leave the line hidden if GitHub cannot be reached or rate-limits the visitor.
		}
	}

	for (const el of document.querySelectorAll<HTMLElement>('.last-commit[data-repo]')) {
		showLastCommit(el);
	}

	// On narrow screens the boxes sit behind a button instead of the right-hand column.
	for (const button of document.querySelectorAll<HTMLButtonElement>('.tool-info-toggle')) {
		button.addEventListener('click', () => {
			const open = button.getAttribute('aria-expanded') !== 'true';
			button.setAttribute('aria-expanded', String(open));
			document.getElementById('tool-info')?.classList.toggle('open', open);
		});
	}
</script>

<style>
	.adoption {
		padding: 1rem var(--sl-sidebar-pad-x);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}
	.adoption h2 {
		color: var(--sl-color-white);
		font-size: var(--sl-text-h5);
		font-weight: 600;
		margin: 0;
	}
	.adoption > a {
		line-height: 0;
	}
	.adoption a::after {
		content: none;
	}
	.adoption img {
		height: 20px;
	}
	.adoption p {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.similar ul {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: var(--sl-text-sm);
	}
	.similar li + li {
		margin-top: 0.25rem;
	}
	.tool-info-toggle {
		display: none;
	}
	@media (max-width: 71.99rem) {
		.tool-info-toggle {
			display: block;
			width: calc(100% - 2 * var(--sl-content-pad-x));
			margin: 0.75rem var(--sl-content-pad-x) 0;
			padding: 0.4rem 0.75rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.5rem;
			background: transparent;
			color: var(--sl-color-white);
			font: inherit;
			font-size: var(--sl-text-sm);
			text-align: left;
			cursor: pointer;
		}
		.tool-info-toggle::after {
			content: '▸';
			float: right;
		}
		.tool-info-toggle[aria-expanded='true']::after {
			content: '▾';
		}
		.tool-info:not(.open) {
			display: none;
		}
		.adoption {
			padding: 0.75rem var(--sl-content-pad-x) 0;
		}
	}
</style>
